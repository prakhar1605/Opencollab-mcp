# GitHub personal access token (classic or fine-grained)
# Scopes needed: public_repo (read-only access to public repositories is enough)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Transport: "stdio" (default, local) or "streamable-http" (remote/deployed).
# "sse" is also accepted as a legacy alias.
# TRANSPORT=stdio

# Bind address for HTTP transport (only used when TRANSPORT=streamable-http or sse).
# Default 0.0.0.0 matches existing Docker deployments. Use 127.0.0.1 to keep
# the server off the local network when running on a laptop.
# HOST=0.0.0.0

# Port for HTTP transport (only used when TRANSPORT=streamable-http or sse)
# PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# OPENCOLLAB_LOG_LEVEL=INFO
